rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products — no auth checks (assignment / learning mode).
    match /products/{productId} {
      allow read, write: if true;
    }

    function validSignupProfile() {
      let role = request.resource.data.get("role", "customer");
      let admin = request.resource.data.get("isAdmin", false);
      return (role == "customer" && admin == false)
        || (role == "admin" && admin == true);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && validSignupProfile();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && (
          (
            request.resource.data.get("role", "customer")
              == resource.data.get("role", "customer")
            && request.resource.data.get("isAdmin", false)
              == resource.data.get("isAdmin", false)
          )
          || (
            resource.data.get("role", "") == "admin"
            && request.resource.data.get("role", "") == "admin"
            && request.resource.data.get("isAdmin", false) == true
          )
        );
    }
  }
}
